{
  "name": "blackboxvtt",
  "version": "1.0.0",
  "description": "BlackBox VTT is a self-hosted Electron virtual tabletop for running secure, persistent multiplayer campaigns. It combines real-time scene editing, maps, fog, journals, chat, dice rolling, asset management, permissions, and D&D 5e/5.5e support.",
  "homepage": "https://github.com/ZainGill45/BlackBoxVTT#readme",
  "bugs": {
    "url": "https://github.com/ZainGill45/BlackBoxVTT/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZainGill45/BlackBoxVTT.git"
  },
  "author": "Zain Gill",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "dependencies:check": "node scripts/checkAllowedDependencies.mjs",
    "cycles:check": "depcruise --config dependency-cruiser.config.cjs src",
    "lint": "npm run format && npm run format:check && npm run dependencies:check && eslint . --max-warnings 0 && npm run cycles:check && npm run typecheck",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run lint && electron-forge package"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "dependency-cruiser": "^18.2.0",
    "dprint": "^0.57.0",
    "electron": "^44.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "material-symbols": "^0.47.0",
    "pixi.js": "^8.20.1",
    "vue": "^3.5.42",
    "zod": "^4.5.1"
  }
}
