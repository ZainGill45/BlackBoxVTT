{
  "name": "blackboxvtt",
  "version": "1.0.0",
  "description": "BlackBox VTT is a self-hosted Electron virtual tabletop for running secure, persistent multiplayer campaigns. It combines real-time scene editing, maps, fog, journals, chat, dice rolling, asset management, permissions, and D&D 5e/5.5e support.",
  "homepage": "https://github.com/ZainGill45/BlackBoxVTT#readme",
  "bugs": {
    "url": "https://github.com/ZainGill45/BlackBoxVTT/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZainGill45/BlackBoxVTT.git"
  },
  "author": "Zain Gill",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "build": "npm run typecheck && electron-forge package"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@types/node": "^26.4.0",
    "electron": "^44.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
